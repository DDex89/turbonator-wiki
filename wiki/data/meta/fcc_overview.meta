'95 Neon FCC: hardware and firmware overview

----------

This page and its companions (calibration, diagnostics and communication, fault codes, engine control and tuning notes) summarise the reverse-engineered, rebuildable firmware source published at github.com/DDex89/neon-fcc-firmware. The source assembles back into the original ROM images byte for byte, so every statement below can be checked against real code. Statements marked";}s:8:"relation";a:3:{s:10:"references";a:4:{s:15:"fcc_calibration";b:1;s:7:"fcc_sci";b:1;s:15:"fcc_fault_codes";b:1;s:16:"fcc_tuning_notes";b:1;}s:5:"media";a:3:{s:29:"fcc_crank_cam_scope_owner.jpg";b:1;s:35:"fcc_crank_cam_reference_capture.jpg";b:1;s:32:"fcc_crank_cam_sequence_chart.jpg";b:1;}s:10:"firstimage";s:29:"fcc_crank_cam_scope_owner.jpg";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}s:11:"last_change";a:10:{s:4:"date";i:1795457302;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:12:"fcc_overview";s:4:"user";s:0:"";s:3:"sum";s:23:"created - external edit";s:5:"extra";s:0:"";s:10:"sizechange";i:25354;s:9:"timestamp";i:1795457302;s:4:"mode";s:4:"page";}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1795457302;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:10:{s:4:"date";i:1795457302;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"C";s:2:"id";s:12:"fcc_overview";s:4:"user";s:0:"";s:3:"sum";s:23:"created - external edit";s:5:"extra";s:0:"";s:10:"sizechange";i:25354;s:9:"timestamp";i:1795457302;s:4:"mode";s:4:"page";}}}