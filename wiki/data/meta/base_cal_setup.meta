Basic Calibration Setup

----------

This section will walk thru the process of getting a base cal setup. For most users, following these instructions will get you to a 90% cal. For many users this will be good enough. Others should follow up with the 'Fine Tuning' section to understand datalogging and how to use it to fully tune in the cal.";}s:8:"relation";a:3:{s:10:"references";a:8:{s:13:"template_file";b:1;s:21:"turbonator_and_mptune";b:1;s:10:"fuel_setup";b:1;s:17:"afr-peftbl_tuning";b:1;s:11:"wb2nb_setup";b:1;s:10:"file_types";b:1;s:18:"how_to_flash_a_cal";b:1;s:19:"chip_burning_basics";b:1;}s:5:"media";a:14:{s:18:"mpt_editor_win.jpg";b:1;s:22:"turbn_config_flags.jpg";b:1;s:15:"mpt_scaling.jpg";b:1;s:15:"mpt_add_inj.jpg";b:1;s:20:"afr_setting_menu.jpg";b:1;s:14:"afr_editor.jpg";b:1;s:15:"fuel_tables.jpg";b:1;s:10:"batoff.jpg";b:1;s:10:"peftbl.jpg";b:1;s:14:"peftbl_rot.jpg";b:1;s:20:"timing_add_point.jpg";b:1;s:22:"timing_add_point_6.jpg";b:1;s:20:"timing_new_point.jpg";b:1;s:13:"timing_3d.jpg";b:1;}s:10:"firstimage";s:18:"mpt_editor_win.jpg";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:11:"last_change";a:7:{s:4:"date";i:1435077525;s:2:"ip";s:15:"205.144.100.200";s:4:"type";s:1:"E";s:2:"id";s:14:"base_cal_setup";s:4:"user";s:8:"shelgame";s:3:"sum";s:0:"";s:5:"extra";s:0:"";}s:4:"date";a:1:{s:7:"created";i:1435077525;}s:4:"user";s:0:"";s:7:"creator";s:0:"";}}