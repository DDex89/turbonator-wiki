SBEC3: reading and reflashing over the SCI line

----------

This is experimental, bench-tested reflashing, not a commercial tool like the FCC's FCCFlash. It erases and rewrites the ECU's flash directly over the diagnostic line; a failed or interrupted write can leave the ECU unable to run. Keep a known-good dump of the original flash before erasing anything, and do not remove power or disconnect the cable mid-write.";}s:8:"relation";a:2:{s:10:"references";a:2:{s:12:"flash_an_fcc";b:1;s:14:"sbec3_overview";b:1;}s:10:"firstimage";s:0:"";}s:8:"internal";a:2:{s:5:"cache";b:1;s:3:"toc";b:1;}}s:10:"persistent";a:4:{s:4:"date";a:1:{s:7:"created";i:1795457302;}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:11:"last_change";a:10:{s:4:"date";i:1795457432;s:2:"ip";s:9:"127.0.0.1";s:4:"type";s:1:"E";s:2:"id";s:13:"sbec3_reflash";s:4:"user";s:0:"";s:3:"sum";s:13:"external edit";s:5:"extra";s:0:"";s:10:"sizechange";i:6;s:9:"timestamp";i:1795457432;s:4:"mode";s:4:"page";}}}