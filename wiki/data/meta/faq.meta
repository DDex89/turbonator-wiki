a:2:{s:7:"current";a:8:{s:4:"date";a:2:{s:7:"created";i:1421957205;s:8:"modified";i:1421962354;}s:11:"last_change";a:7:{s:4:"date";i:1421962354;s:2:"ip";s:13:"217.92.96.148";s:4:"type";s:1:"E";s:2:"id";s:3:"faq";s:4:"user";s:0:"";s:3:"sum";s:0:"";s:5:"extra";s:0:"";}s:4:"user";s:0:"";s:7:"creator";s:0:"";s:5:"title";s:26:"Frequently Asked Questions";s:11:"description";a:2:{s:15:"tableofcontents";a:25:{i:0;a:4:{s:3:"hid";s:26:"frequently_asked_questions";s:5:"title";s:26:"Frequently Asked Questions";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:1;a:4:{s:3:"hid";s:28:"pumping_efficiency_questions";s:5:"title";s:28:"Pumping Efficiency Questions";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:2;a:4:{s:3:"hid";s:59:"q_-_which_way_do_you_go_w_pump_efficiency_to_make_it_richer";s:5:"title";s:61:"Q - Which way do you go w/ Pump Efficiency to make it richer?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:3;a:4:{s:3:"hid";s:116:"q_-_isn_t_the_idea_basically_that_pumping_efficiency_is_base_fuel_and_then_you_have_idle_mid_wot_tables_to_fine_tune";s:5:"title";s:117:"Q - Isn't the idea basically that pumping efficiency is base fuel and then you have idle/mid/WOT tables to fine tune?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:4;a:4:{s:3:"hid";s:332:"q_-_when_tuning_cals_1st_became_something_everyone_could_do_they_found_that_mopar_just_scaled_the_pe_table_for_the_s60_cal_at_that_time_everyone_was_told_that_is_the_wrong_way_to_do_it_and_not_to_touch_that_now_you_guys_have_reversed_your_tune_to_say_oh_yes_mess_with_the_pe_table_to_make_fueling_adjustments__so_which_is_it_and_why";s:5:"title";s:338:"Q - When tuning cals 1st became something everyone could do they found that Mopar just scaled the PE table for the S60 cal. At that time everyone was told that is the wrong way to do it and not to touch that. Now you guys have reversed your tune to say 'Oh yes mess with the PE table to make fueling adjustments'. So which is it? And WHY?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:5;a:4:{s:3:"hid";s:25:"main_fuel_table_questions";s:5:"title";s:27:"3 Main Fuel Table Questions";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:6;a:4:{s:3:"hid";s:202:"q_-_i_was_wondering_why_the_fuel_full_throttle_has_so_few_data_points_to_adjust_and_the_part_throttle_has_so_many_it_makes_sense_that_you_could_tune_it_more_precisely_with_more_points_or_am_i_just_wrong";s:5:"title";s:205:"Q - I was wondering why the fuel full throttle has so few data points to adjust and the part throttle has so many. It makes sense that you could tune it more precisely with more points, or am I just wrong?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:7;a:4:{s:3:"hid";s:43:"q_-_how_does_the_target_af_work_in_mp_tuner";s:5:"title";s:44:"Q - How does the target AF work in MP Tuner?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:8;a:4:{s:3:"hid";s:57:"q_-_is_there_an_easy_way_to_switch_on_and_off_o2_feedback";s:5:"title";s:58:"Q - Is there an easy way to switch on and off O2 Feedback?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:9;a:4:{s:3:"hid";s:135:"q_it_s_hard_to_adjust_fuel_spark_and_the_wastegate_with_the_computer_constantly_changing_them_how_do_i_disable_the_adaptives_for_tuning";s:5:"title";s:145:"Q – It’s hard to adjust fuel, spark, and the wastegate with the computer constantly changing them. How do I disable the adaptives for tuning?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:10;a:4:{s:3:"hid";s:26:"accelerator_pump_questions";s:5:"title";s:26:"Accelerator Pump Questions";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:11;a:4:{s:3:"hid";s:103:"q_-_i_added_a_bigger_throttle_body_and_i_now_get_a_lean_tip-in_how_do_i_adjust_the_accel_pump_pump_shot";s:5:"title";s:105:"Q - I added a bigger throttle body and I now get a lean tip-in. How do I adjust the Accel Pump/Pump Shot?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:12;a:4:{s:3:"hid";s:24:"other_fuelling_questions";s:5:"title";s:24:"Other Fuelling Questions";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:13;a:4:{s:3:"hid";s:47:"q_-_how_can_i_adjust_fuel_at_idle_coasting_down";s:5:"title";s:49:"Q - how can i adjust fuel at idle/ coasting down?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:14;a:4:{s:3:"hid";s:62:"q_-_what_parameter_to_adjust_the_open_closed_loop_switch_point";s:5:"title";s:63:"Q - What parameter to adjust the open/closed loop switch point?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:15;a:4:{s:3:"hid";s:15:"ignition_timing";s:5:"title";s:15:"Ignition Timing";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:16;a:4:{s:3:"hid";s:80:"q_-_how_is_the_total_timing_calculated_base_timing_advancefromrpm_advancefrommap";s:5:"title";s:86:"Q - How is the total timing calculated? Base timing + AdvancefromRPM + AdvancefromMap?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:17;a:4:{s:3:"hid";s:286:"q_-_so_i_am_clear_on_this_the_timing_shown_in_the_cal_and_on_a_scan_tool_will_be_the_total_timing_this_number_assumes_the_base_timing_of_12_or_whatever_is_called_for_on_the_emissions_label_is_there_so_the_number_shown_in_a_cal_is_not_necessarily_the_number_used_in_a_calculation_correct";s:5:"title";s:299:"Q - So I am clear on this.... The timing shown in the cal, and on a Scan Tool, will be the total timing. This number assumes the base timing of 12* (or whatever is called for on the emissions label) is there. So the number shown in a cal is not necessarily the number used in a calculation, correct?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:18;a:4:{s:3:"hid";s:41:"q_what_is_the_advancefromrpmmax_table_for";s:5:"title";s:49:"Q  What is the AdvanceFromRPMMax table for?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:19;a:4:{s:3:"hid";s:64:"q_what_is_the_multiplieronmapadvancewhenretarding_table_used_for";s:5:"title";s:72:"Q  What is the MultiplierOnMAPAdvanceWhenRetarding table used for?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:20;a:4:{s:3:"hid";s:13:"boost_control";s:5:"title";s:13:"Boost Control";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:21;a:4:{s:3:"hid";s:73:"q_-_how_do_you_raise_the_overboost_cutout_point_in_t-sbec_t-smec_and_t-lm";s:5:"title";s:75:"Q - How do you raise the overboost cutout point in T-SBEC, T-SMEC and T-LM?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:22;a:4:{s:3:"hid";s:88:"q_-_i_only_have_full_boost_if_i_go_past_3_4_throttle_till_that_only_have_about_5_psi_why";s:5:"title";s:91:"Q - I only have full boost if I go past 3/4 throttle, till that only have about 5 psi. Why?";s:4:"type";s:2:"ul";s:5:"level";i:3;}i:23;a:4:{s:3:"hid";s:7:"general";s:5:"title";s:7:"General";s:4:"type";s:2:"ul";s:5:"level";i:2;}i:24;a:4:{s:3:"hid";s:40:"q_-_what_offset_do_i_use_to_burn_my_chip";s:5:"title";s:43:"Q - What 'offset' do I use to burn my chip?";s:4:"type";s:2:"ul";s:5:"level";i:3;}}s:8:"abstract";s:271:"Frequently Asked Questions

